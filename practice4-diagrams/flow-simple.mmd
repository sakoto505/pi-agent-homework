  classDef llm fill:#1d3557,stroke:#457b9d,color:#eaf2f8;
  classDef remote fill:#0f2027,stroke:#2a9d8f,color:#e8f4f2;
  class CA app;
  class AG core;
  class AI llm;
  class RM remote;
